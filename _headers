# ──────────────────────────────────────────────────────────────────
# AVOXAN — Cloudflare Pages headers
# ──────────────────────────────────────────────────────────────────
# NOTE: /houston-med-spas previously carried an X-Robots-Tag of
# "noindex, nofollow" here, from when it was a private cold-email
# landing page. It is now a public, indexable page (in sitemap.xml,
# linked from /ai-receptionist and /services), so that header has
# been removed. An HTTP X-Robots-Tag OVERRIDES the <meta robots>
# tag in the HTML — if you ever re-add a noindex here, the page will
# drop out of search no matter what the page markup says.
# ──────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────
# Caching: always revalidate HTML so new deploys appear immediately and
# a stale page can never get pinned in a browser/edge cache.
# ──────────────────────────────────────────────────────────────────

# The kill-switch service worker must never be cached.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Everything (HTML pages use clean, extensionless URLs) — revalidate.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Versioned assets cache hard for a year. EVERY file under these paths
# MUST be referenced with a ?v= query string that you bump on change —
# otherwise returning visitors keep the old file for up to a year and
# a fix you deploy never reaches them.
# Current versions: avoxan-v2.css?v=18 · avoxan-v2.js?v=7
#                   avoxan-chat.js?v=2 · avoxan-ai-pricing.js?v=2
/css/*
  Cache-Control: public, max-age=31536000
/js/*
  Cache-Control: public, max-age=31536000
